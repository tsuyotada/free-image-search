# ──────────────────────────────────────────────────────────────────────────────
# Free Stock Finder — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# For Vercel deployment: add each variable in
#   Project Settings > Environment Variables
# ──────────────────────────────────────────────────────────────────────────────


# ── Image source APIs ─────────────────────────────────────────────────────────

# Unsplash API key (required for hero background and Unsplash search results)
# https://unsplash.com/developers → Your apps → Keys
UNSPLASH_KEY=your_unsplash_access_key

# Pexels API key
# https://www.pexels.com/api/
PEXELS_KEY=your_pexels_api_key

# Pixabay API key
# https://pixabay.com/api/docs/
PIXABAY_KEY=your_pixabay_api_key


# ── AI features ───────────────────────────────────────────────────────────────

# OpenAI API key (required for AI Recommend feature)
OPENAI_API_KEY=your_openai_api_key


# ── Analytics ─────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (optional)
# https://analytics.google.com → Admin > Data streams > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# ── Google AdSense (optional — enables ad monetization) ──────────────────────
#
# How to obtain these values:
#   1. Sign in to Google AdSense (https://adsense.google.com)
#   2. Ads > By ad unit > Create new ad unit
#   3. Choose "In-feed ads" for LAYOUT_KEY, or "Display ads" for auto format
#
# NEXT_PUBLIC_ADSENSE_CLIENT_ID
#   Your publisher ID, always starts with "ca-pub-"
#   Found in: AdSense > Account > Account information
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# NEXT_PUBLIC_ADSENSE_INFEED_SLOT_ID
#   The slot ID of the specific ad unit you created (numbers only)
#   Found in: AdSense > Ads > By ad unit > [your unit] > Get code
NEXT_PUBLIC_ADSENSE_INFEED_SLOT_ID=XXXXXXXXXX

# NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY  (optional)
#   Required only when using an "In-feed ads" unit (data-ad-format="fluid").
#   Omit this variable to use a standard responsive display ad instead.
#   Found in: the generated ad code snippet, e.g. -6t+ed+2i-1n-4w
# NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=-6t+ed+2i-1n-4w
